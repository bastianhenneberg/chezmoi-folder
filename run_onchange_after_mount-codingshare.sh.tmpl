{{- if ne .machine "omarchy" -}}
#!/usr/bin/env bash
# Bindet den SMB-Share "codingshare" der Codingmachine fest ein — als normalen
# Ordner unter ~/Development/codingshare, also derselbe Pfad wie auf der
# Codingmachine selbst. Auf der Codingmachine (omarchy) laeuft das nicht, dort
# ist der Ordner lokal.
#
# Warum nicht einfach Nautilus/gvfs: gvfs gibt anderen Programmen nur dann einen
# echten Pfad, wenn gvfsd-fuse laeuft. Tut es das nicht, bekommt z.B. nvim beim
# "Oeffnen mit" eine smb://-Adresse und kann nichts damit anfangen (19.10.2026).
#
# x-systemd.automount: eingebunden wird erst beim ersten Zugriff. Ist die
# Codingmachine nicht erreichbar, bootet der Rechner trotzdem (nofail), und ein
# Zugriff gibt nach 10 s auf statt zu haengen.
# Ueber die NetBird-IP, damit es zu Hause und unterwegs gleich funktioniert.
#
# Das Passwort steht NICHT in diesem Repo: es kommt aus dem Schluesselbund
# (Nautilus hat es dort abgelegt) oder wird einmal abgefragt und landet in
# /etc/samba/credentials/codingshare (root, 600).
# Braucht sudo. Idempotent: ist der fstab-Eintrag schon da, passiert nichts.
set -euo pipefail

SERVER=100.97.97.130
SHARE=codingshare
SMB_USER=codingmachine
MOUNTPUNKT="$HOME/Development/codingshare"
CREDS=/etc/samba/credentials/codingshare
QUELLE="//$SERVER/$SHARE"

if grep -qsE "^[^#]*[[:space:]]$MOUNTPUNKT[[:space:]]+cifs" /etc/fstab; then
    echo "[codingshare] fstab-Eintrag vorhanden — nichts zu tun."
    exit 0
fi

if ! command -v mount.cifs >/dev/null 2>&1; then
    echo "[codingshare] cifs-utils fehlt — bitte installieren und chezmoi apply erneut ausfuehren."
    exit 0
fi

mkdir -p "$MOUNTPUNKT"
if [ -n "$(ls -A "$MOUNTPUNKT" 2>/dev/null)" ]; then
    echo "[codingshare] $MOUNTPUNKT ist nicht leer — breche ab, bitte erst pruefen."
    exit 1
fi

if ! sudo test -f "$CREDS"; then
    # Nach Attributen suchen, nicht nach dem Label — "search label ..." findet
    # nichts und lieferte am 19.10.2026 ein leeres Passwort (STATUS_LOGON_FAILURE).
    PASS=$(secret-tool lookup protocol smb server "$SERVER" user "$SMB_USER" 2>/dev/null \
        || secret-tool lookup protocol smb server 192.168.1.132 user "$SMB_USER" 2>/dev/null || true)
    if [ -z "$PASS" ]; then
        read -rsp "[codingshare] Passwort fuer $SMB_USER@$SERVER: " PASS
        echo
    fi
    sudo install -d -m 700 /etc/samba/credentials
    printf 'username=%s\npassword=%s\n' "$SMB_USER" "$PASS" \
        | sudo install -m 600 /dev/stdin "$CREDS"
fi

OPTS="credentials=$CREDS,uid=$(id -u),gid=$(id -g),file_mode=0644,dir_mode=0755,vers=3.1.1"
OPTS="$OPTS,_netdev,nofail,noauto,x-systemd.automount,x-systemd.idle-timeout=600"
OPTS="$OPTS,x-systemd.mount-timeout=10,x-systemd.requires=network-online.target"

echo "[codingshare] Trage $QUELLE -> $MOUNTPUNKT in /etc/fstab ein ..."
printf '\n# codingshare der Codingmachine (chezmoi: run_onchange_after_mount-codingshare.sh)\n%s %s cifs %s 0 0\n' \
    "$QUELLE" "$MOUNTPUNKT" "$OPTS" | sudo tee -a /etc/fstab >/dev/null

UNIT=$(systemd-escape --path --suffix=automount "$MOUNTPUNKT")
sudo systemctl daemon-reload
sudo systemctl reset-failed "$UNIT" "${UNIT%.automount}.mount" 2>/dev/null || true
sudo systemctl restart "$UNIT"
if ls "$MOUNTPUNKT" >/dev/null 2>&1 && findmnt -n -t cifs "$MOUNTPUNKT" >/dev/null; then
    echo "[codingshare] Eingebunden: $MOUNTPUNKT"
else
    echo "[codingshare] Einbinden fehlgeschlagen — siehe: journalctl -b | grep -i cifs"
    echo "              Passwort falsch? sudo rm $CREDS und Skript erneut ausfuehren."
    exit 1
fi

{{- end }}
