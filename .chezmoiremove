# omarchy-sleep-lock.service.
#
# Bleibt bewusst stehen: hyprsunset.conf und xdph.conf - hyprsunset 0.4.0 und
# xdg-desktop-portal-hyprland 1.4.1 sind installiert und lesen sie weiterhin
# (omarchy-toggle-nightlight ruft hyprsunset direkt auf).
.config/hypr/autostart.conf
