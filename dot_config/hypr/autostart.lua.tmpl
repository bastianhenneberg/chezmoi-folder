-- Extra autostart processes.

{{ if eq .machine "desktop" -}}
-- Netzlaufwerk mounten (wartet auf Netbird + Server erreichbar)
o.exec_on_start(
  "bash -c 'until ping -c1 -W1 100.97.97.130 &>/dev/null; do sleep 2; done; sleep 1; mount /mnt/netzwerk-vault'"
)

-- Workspaces vorbereiten, damit die Fenster ihre Zielplätze finden.
-- Hyprland 0.56 nimmt bei `hyprctl dispatch` nur noch Lua entgegen, deshalb
-- hl.dsp.focus(...) statt `dispatch workspace N` (siehe scripts/ws-switch.sh).
o.exec_on_start(
  [[sleep 1 && hyprctl dispatch 'hl.dsp.focus({ workspace = "2" })' && hyprctl dispatch 'hl.dsp.focus({ workspace = "1" })']]
)

-- Workspace 1 (DP-3, links): Chromium (über die .desktop-Datei, wie im Menü)
o.exec_on_start("sleep 2 && uwsm app -- chromium.desktop")

-- Workspace 2 (DP-2, Mitte): Ghostty
o.exec_on_start("sleep 4 && uwsm app -- ghostty --title=Ghostty-WS2")
{{- else if eq .machine "laptop" -}}
-- Netzlaufwerk mounten (wartet auf Netbird + Server erreichbar)
o.exec_on_start(
  "bash -c 'until ping -c1 -W1 100.97.97.130 &>/dev/null; do sleep 2; done; sleep 1; mount /mnt/netzwerk-vault'"
)

-- Workspace auf externem Monitor erstellen.
-- Hyprland 0.56 nimmt bei `hyprctl dispatch` nur noch Lua entgegen, deshalb
-- hl.dsp.focus(...) statt `dispatch workspace N` (siehe scripts/ws-switch.sh).
o.exec_on_start([[sleep 1 && hyprctl dispatch 'hl.dsp.focus({ workspace = "2" })']])

-- Workspace 1 (eDP-2): Chromium — über die .desktop-Datei, damit der
-- Wrapper (~/.local/bin/chromium-wrapper, LIBVA_DRIVER_NAME=radeonsi) greift.
o.exec_on_start("sleep 2 && uwsm app -- chromium.desktop")

-- Workspace 2 (HDMI-A-1): Ghostty (ohne tmux, da wir Herd nutzen)
o.exec_on_start("sleep 8 && uwsm app -- ghostty --title=Ghostty-WS2")
{{- else if eq .machine "omarchy" -}}
-- Nichts automatisch starten.
-- o.launch_on_start("my-service")
{{- else -}}
{{ fail (printf "autostart.lua: unbekannter Rechner %q — Zweig ergaenzen (laptop/desktop/omarchy)" .machine) }}
{{- end }}
