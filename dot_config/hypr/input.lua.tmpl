-- Persönliche Input-Overrides. Ersetzen Omarchys Defaults.
-- See https://wiki.hypr.land/Configuring/Basics/Variables/#input

hl.config({
  input = {
    -- Zwei Layouts, Umschalten per SUPER + SPACE (siehe bindings.lua ->
    -- scripts/toggle-kb-layout.sh, das per Index auf 0 = us / 1 = de schaltet).
    kb_layout = "us,de",
    kb_options = "compose:caps",

    -- Change speed of keyboard repeat.
    repeat_rate = 40,
    repeat_delay = 600,

    -- Start with numlock on by default.
    numlock_by_default = true,
{{- if eq .machine "laptop" }}

    touchpad = {
      -- Control the speed of your scrolling.
      scroll_factor = 0.4,
    },
{{- end }}
  },
})
{{- if eq .machine "laptop" }}

-- Im Terminal schneller scrollen
o.window("(Alacritty|kitty|foot)", { scroll_touchpad = 1.5 })
o.window("com.mitchellh.ghostty", { scroll_touchpad = 0.2 })
{{- end }}
