-- Learn how to configure Hyprland: https://wiki.hypr.land/Configuring/Start/

-- Omarchy's bootstrap keeps path setup out of this user config.
dofile((os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/default/hypr/bootstrap.lua")

-- Load Omarchy defaults.
require("default.hypr.omarchy")

-- Put your personal overrides in these files. They're loaded after Omarchy's
-- defaults so package updates can improve the defaults without rewriting your
-- ~/.config/hypr files.
require("hypr.monitors")
require("hypr.input")
require("hypr.bindings")
require("hypr.looknfeel")
require("hypr.autostart")

-- Toggle config flags dynamically.
require("default.hypr.toggles")

-- ---------------------------------------------------------------------------
-- Persönliche Ergänzungen
-- ---------------------------------------------------------------------------
-- NVIDIA-Envs setzt Omarchy 4 selbst (default/hypr/nvidia.lua) — hier nur noch,
-- was darüber hinausgeht.
{{ if eq .machine "desktop" -}}
-- Autostart-Fenster auf ihre Plätze (siehe autostart.lua)
o.window("^([Gg]oogle-chrome)$", { workspace = "1" }) -- DP-3, links
o.window({ title = "^Ghostty-WS2$" }, { workspace = "2" }) -- DP-2, Mitte
o.window({ title = "^Ghostty-WS4$" }, { workspace = "4" }) -- DP-2, Mitte

-- Manuell gestartete Apps
o.window("^obsidian$", { workspace = "4" })
o.window("^org\\.mozilla\\.Thunderbird$", { workspace = "5" })
{{- else if eq .machine "laptop" -}}
-- Autostart-Fenster auf ihre Plätze (siehe autostart.lua)
o.window("^zen$", { monitor = "eDP-2" })
o.window({ title = "^Ghostty-WS2$" }, { workspace = "2" })
o.window({ title = "^Ghostty-WS4$" }, { workspace = "4" })

-- Manuell gestartete Apps
o.window("^obsidian$", { workspace = "4" })
o.window("^org\\.mozilla\\.Thunderbird$", { workspace = "5" })
{{- else if eq .machine "omarchy" -}}
-- Software-Cursor für wayvnc: ein Hardware-Cursor taucht im VNC-Stream nicht
-- auf, weil er nie ins Framebuffer gerendert wird. WLR_NO_HARDWARE_CURSORS
-- greift dafür nicht mehr — Hyprland setzt seit 0.41 nicht mehr auf wlroots
-- und ignoriert die Variable. Der Default 2 ("auto") überlässt die Wahl dem
-- Treiber, deshalb hier explizit.
hl.config({
  cursor = {
    no_hardware_cursors = true,
  },
})
{{- end }}
