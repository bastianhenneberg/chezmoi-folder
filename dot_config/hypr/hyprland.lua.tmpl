-- Learn how to configure Hyprland: https://wiki.hypr.land/Configuring/Start/

-- Omarchy's bootstrap keeps path setup out of this user config.
dofile((os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/default/hypr/bootstrap.lua")

-- Load Omarchy defaults.
require("default.hypr.omarchy")

-- Put your personal overrides in these files. They're loaded after Omarchy's
-- defaults so package updates can improve the defaults without rewriting your
-- ~/.config/hypr files.
require("hypr.monitors")
require("hypr.input")
require("hypr.bindings")
require("hypr.looknfeel")
require("hypr.autostart")

-- Toggle config flags dynamically.
require("default.hypr.toggles")

-- ---------------------------------------------------------------------------
-- Persönliche Ergänzungen
-- ---------------------------------------------------------------------------
-- NVIDIA-Envs setzt Omarchy 4 selbst (default/hypr/nvidia.lua) — hier nur noch,
-- was darüber hinausgeht.
{{ if eq .machine "desktop" -}}
-- ACHTUNG, seit 18.11.2026: Per-Monitor-Workspaces sind aktiv. Eine absolute
-- Nummer wie workspace = "4" zeigt jetzt auf Platz 4 in BLOCK 1, also auf dem
-- Monitor, dem Omarchy den ersten Block gegeben hat (internes Panel zuerst,
-- sonst niedrigste Hyprland-id) - nicht mehr zwangslaeufig auf DP-2.
-- Bewusst NICHT auf `monitor = ...` umgeschrieben: das wuerde die Trennung
-- aufheben und Obsidian, Thunderbird und Ghostty auf einem Workspace stapeln.
-- Beim Praxistest pruefen, auf welchem Schirm sie landen, und erst dann
-- entscheiden.
-- Autostart-Fenster auf ihre Plätze (siehe autostart.lua)
o.window("^chromium$", { workspace = "1" }) -- DP-3, links
o.window({ title = "^Ghostty-WS2$" }, { workspace = "2" }) -- DP-2, Mitte

-- Manuell gestartete Apps
o.window("^obsidian$", { workspace = "4" })
o.window("^org\\.mozilla\\.Thunderbird$", { workspace = "5" })

-- WoW (Battle.net via Steam/Proton): immer Vollbild; Wine darf es nicht wieder
-- zurücksetzen (Super+F schaltet weiterhin um). Launcher aus dem Weg auf WS 5,
-- sonst klaut er den Fokus und WoW fällt aus dem Vollbild.
o.window({ class = "^steam_app_2336359447$", title = "^World of Warcraft$" }, {
  fullscreen = true,
  suppress_event = "fullscreen maximize",
})
o.window({ class = "^steam_app_2336359447$", title = "^Battle\\.net$" }, { workspace = "5" })
{{- else if eq .machine "laptop" -}}
-- Autostart-Fenster auf ihre Plätze (siehe autostart.lua)
o.window("^chromium$", { monitor = "eDP-2" })
o.window({ title = "^Ghostty-WS2$" }, { workspace = "2" })

-- Manuell gestartete Apps
o.window("^obsidian$", { workspace = "4" })
o.window("^org\\.mozilla\\.Thunderbird$", { workspace = "5" })
{{- else if eq .machine "codingmachine" -}}
-- Hier steht bewusst nichts mehr. Bis 18.11.2026 erzwang dieser Zweig
-- `no_hardware_cursors = true`, weil wayvnc den Hardware-Cursor nie im Stream
-- zeigte (er wird nicht ins Framebuffer gerendert). wayvnc ist weg, und Gliff
-- - Omarchys eigene Fernwartung ueber SSH - uebertraegt die Cursorform als
-- eigene Nachricht, liest sie also nicht aus dem Framebuffer. Der Zweig
-- bleibt leer bestehen, damit codingmachine nicht in den fail-Zweig laeuft.
{{- else -}}
{{ fail (printf "hyprland.lua: unbekannter Rechner %q — Zweig ergaenzen (laptop/desktop/codingmachine)" .machine) }}
{{- end }}
