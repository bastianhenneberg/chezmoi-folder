-- Learn how to configure Hyprland: https://wiki.hypr.land/Configuring/Start/

-- Omarchy's bootstrap keeps path setup out of this user config.
dofile((os.getenv("OMARCHY_PATH") or "/usr/share/omarchy") .. "/default/hypr/bootstrap.lua")

-- Load Omarchy defaults.
require("default.hypr.omarchy")

-- Put your personal overrides in these files. They're loaded after Omarchy's
-- defaults so package updates can improve the defaults without rewriting your
-- ~/.config/hypr files.
require("hypr.monitors")
require("hypr.input")
require("hypr.bindings")
require("hypr.looknfeel")
require("hypr.autostart")

-- Toggle config flags dynamically.
require("default.hypr.toggles")

-- ---------------------------------------------------------------------------
-- Persönliche Ergänzungen
-- ---------------------------------------------------------------------------
-- NVIDIA-Envs setzt Omarchy 4 selbst (default/hypr/nvidia.lua) — hier nur noch,
-- was darüber hinausgeht.

-- Fenster auf die festen Plaetze von SUPER+N (workspace_keys in monitors.lua).
-- Keine Hyprland-Nummern direkt: die gehoeren seit Omarchys Workspaces pro
-- Monitor einem Monitor-Block. Ist der Block noch unbekannt, wenigstens der
-- richtige Monitor.
local function on_key(key)
  local id = workspace_key_id(key)
  if id then
    return { workspace = tostring(id) }
  end
  return { monitor = workspace_keys[key][1] }
end

{{ if eq .machine "desktop" -}}
-- Autostart-Fenster auf ihre Plätze (siehe autostart.lua)
o.window("^chromium$", on_key(1)) -- SUPER+1, Samsung links
o.window({ title = "^Ghostty-WS2$" }, on_key(2)) -- SUPER+2, BenQ Mitte

-- Manuell gestartete Apps
o.window("^obsidian$", on_key(4))
o.window("^org\\.mozilla\\.Thunderbird$", on_key(5))

-- WoW (Battle.net via Steam/Proton): immer Vollbild; Wine darf es nicht wieder
-- zurücksetzen (Super+F schaltet weiterhin um). Launcher aus dem Weg auf SUPER+5,
-- sonst klaut er den Fokus und WoW fällt aus dem Vollbild.
o.window({ class = "^steam_app_2336359447$", title = "^World of Warcraft$" }, {
  fullscreen = true,
  suppress_event = "fullscreen maximize",
})
o.window({ class = "^steam_app_2336359447$", title = "^Battle\\.net$" }, on_key(5))
{{- else if eq .machine "laptop" -}}
-- Autostart-Fenster auf ihre Plätze (siehe autostart.lua)
o.window("^chromium$", on_key(1)) -- SUPER+1, Laptop-Display
o.window({ title = "^Ghostty-WS2$" }, on_key(2)) -- SUPER+2, MateView

-- Manuell gestartete Apps
o.window("^obsidian$", on_key(4))
o.window("^org\\.mozilla\\.Thunderbird$", on_key(5))
{{- else if eq .machine "codingmachine" -}}
-- Software-Cursor für wayvnc: ein Hardware-Cursor taucht im VNC-Stream nicht
-- auf, weil er nie ins Framebuffer gerendert wird. WLR_NO_HARDWARE_CURSORS
-- greift dafür nicht mehr — Hyprland setzt seit 0.41 nicht mehr auf wlroots
-- und ignoriert die Variable. Der Default 2 ("auto") überlässt die Wahl dem
-- Treiber, deshalb hier explizit.
hl.config({
  cursor = {
    no_hardware_cursors = true,
  },
})
{{- else -}}
{{ fail (printf "hyprland.lua: unbekannter Rechner %q — Zweig ergaenzen (laptop/desktop/codingmachine)" .machine) }}
{{- end }}
