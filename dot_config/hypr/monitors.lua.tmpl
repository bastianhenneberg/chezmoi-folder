-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all
--
-- Ab Omarchy 4 ("quattro") konfiguriert Hyprland in Lua. Die alte
-- monitors.conf wird nicht mehr gelesen.

-- ---------------------------------------------------------------------------
-- Feste Workspace-Plaetze fuer SUPER+1..0
-- ---------------------------------------------------------------------------
-- Seit 16.11.2026 hat Omarchy Workspaces pro Monitor
-- (/usr/share/omarchy/default/hypr/monitor-workspaces.lua): jeder Monitor
-- besitzt einen Block von zehn Hyprland-Workspaces (Block 0 = 1-10, Block 1 =
-- 11-20 ...), welcher Monitor welchen Block hat, steht in
-- ~/.local/state/omarchy/monitor-workspaces. Die Bar zeigt pro Monitor nur
-- seinen Block, nummeriert 1-10.
--
-- Wir behalten trotzdem feste Plaetze: `workspace_keys[N] = { Monitor, Platz }`
-- sagt, wohin SUPER+N springt (bindings.lua) und wo Fensterregeln landen
-- (hyprland.lua). Hartkodierte Hyprland-Nummern wie "workspace 2" gehen nicht
-- mehr - die gehoeren jetzt irgendeinem Monitor-Block. Rechner ohne Tabelle
-- bekommen Omarchys Verhalten (SUPER+N = Platz N auf dem aktuellen Monitor).
_G.workspace_keys = nil

local function workspace_blocks()
  local state = os.getenv("XDG_STATE_HOME") or ((os.getenv("HOME") or "") .. "/.local/state")
  local blocks = {}
  local file = io.open(state .. "/omarchy/monitor-workspaces", "r")
  if file then
    for line in file:lines() do
      local block, connector = line:match("^(%d+)\t([^\t]*)\t")
      if block and connector ~= "" then
        blocks[connector] = tonumber(block)
      end
    end
    file:close()
  end
  return blocks
end

-- Omarchy vor den Workspaces pro Monitor (z.B. 4.0.x) kennt o.workspaces
-- nicht. Dort gilt die alte globale Nummerierung: SUPER+N = Workspace N, die
-- workspace_rules unten legen ihn auf seinen Monitor.
_G.per_monitor_workspaces = (o and o.workspaces) ~= nil

-- Hyprland-Workspace-Nummer hinter SUPER+key, nil wenn (noch) unbekannt.
function _G.workspace_key_id(key)
  local place = _G.workspace_keys and _G.workspace_keys[key]
  if place and not _G.per_monitor_workspaces then
    return key
  end
  local block = place and workspace_blocks()[place[1]]
  return block and (block * 10 + place[2]) or nil
end

{{ if eq .machine "desktop" -}}
hl.env("GDK_SCALE", "1")

-- Fallback für unbekannte Ausgänge (wird von den Regeln unten überschrieben).
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })

-- Desktop-Setup (3 Monitore, v.l.n.r.)
-- Samsung LC27G7xT (DP-3) | BenQ PD2700U (DP-2, Main, 4K) | BenQ ZOWIE XL (DP-1)
hl.monitor({ output = "DP-3", mode = "2560x1440@240", position = "0x0", scale = 1 })
hl.monitor({ output = "DP-2", mode = "3840x2160@60", position = "2560x0", scale = 1 })
hl.monitor({ output = "DP-1", mode = "1920x1080@240", position = "6400x0", scale = 1 })

-- Feste Plaetze (siehe oben): SUPER+1 = Samsung links, SUPER+2 = BenQ Mitte,
-- SUPER+3 = ZOWIE rechts, SUPER+4..0 = weitere Plaetze auf dem BenQ.
_G.workspace_keys = {
  { "DP-3", 1 },
  { "DP-2", 1 },
  { "DP-1", 1 },
  { "DP-2", 2 },
  { "DP-2", 3 },
  { "DP-2", 4 },
  { "DP-2", 5 },
  { "DP-2", 6 },
  { "DP-2", 7 },
  { "DP-2", 8 },
}

-- XREAL One Pro an HDMI-A-1, nur fuer Spiele und Filme, rechts neben den
-- dreien. Wird zum Abschalten abgezogen; beim Einstecken gilt diese Regel.
local xreal = "desc:Nreal XREAL One Pro"
hl.monitor({ output = xreal, mode = "1920x1080@90", position = "8320x0", scale = 1 })
-- World of Warcraft startet immer auf der Brille, solange sie an ist.
hl.window_rule({
  name = "wow-on-xreal",
  match = { title = "^World of Warcraft$" },
  monitor = xreal,
  fullscreen = true,
})
{{- else if eq .machine "laptop" -}}
hl.env("GDK_SCALE", "1")

-- Fallback für unbekannte Ausgänge (wird von den Regeln unten überschrieben).
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1.25 })

-- Laptop-Setup
hl.monitor({ output = "eDP-2", mode = "2560x1440@240", position = "0x0", scale = 1 })
-- HDMI-Monitor Büro
hl.monitor({ output = "HDMI-A-1", mode = "3840x2560@50", position = "2560x0", scale = 1 })

-- Feste Plaetze (siehe oben): SUPER+1 = Laptop-Display, SUPER+2..5 und 7..0 =
-- MateView, SUPER+6 = XREAL (DP-1, nur wenn eingesteckt).
_G.workspace_keys = {
  { "eDP-2", 1 },
  { "HDMI-A-1", 1 },
  { "HDMI-A-1", 2 },
  { "HDMI-A-1", 3 },
  { "HDMI-A-1", 4 },
  { "DP-1", 1 },
  { "HDMI-A-1", 5 },
  { "HDMI-A-1", 6 },
  { "HDMI-A-1", 7 },
  { "HDMI-A-1", 8 },
}

-- XREAL One Pro, am NVIDIA-Port (DP-1). Nur dieser Port traegt die 297 MHz
-- fuer Ultra-Wide; der AMD-Port trainiert den Link nur auf RBR.
--
-- mode = "highrr" ist ABSICHT, nicht auf einen festen Modus aendern:
--   Normalmodus  -> waehlt 1920x1080@120 (statt der bevorzugten 90)
--   Ultra-Wide   -> waehlt 3840x1080@60, dem einzigen dann verfuegbaren
-- Ein fest verdrahteter Modus wuerde die Brille beim Umschalten auf
-- Ultra-Wide zurueckzwingen.
hl.monitor({ output = "desc:Nreal XREAL One Pro", mode = "highrr", position = "auto-right", scale = 1 })
{{- else if eq .machine "codingmachine" -}}
-- codingmachine (Prod) — Huawei MateView (HDMI-A-1, 3840x2560@50), feste Skalierung
-- 1.25 (vor Ort so eingestellt, Auto-Detect mit GDK_SCALE 2 war zu gross)
hl.env("GDK_SCALE", "1")
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1.25 })

-- Virtueller Monitor fuer Agents (imkr Computer-Use, #9074). Angelegt im
-- Autostart per `hyprctl output create headless AGENT`; laeuft auch, wenn der
-- echte Monitor aus ist oder fehlt. 2560x1440 bei Skalierung 1 (Bastian, 29.10.2026).
hl.monitor({ output = "AGENT", mode = "2560x1440@60", position = "auto-right", scale = 1 })
{{- else -}}
{{ fail (printf "monitors.lua: unbekannter Rechner %q — Zweig ergaenzen (laptop/desktop/codingmachine)" .machine) }}
{{- end }}

-- Die festen Plaetze an ihren Monitor binden, damit ein Workspace, den eine
-- Fensterregel erst anlegt, gleich auf dem richtigen Monitor entsteht.
for key, place in ipairs(_G.workspace_keys or {}) do
  local id = _G.workspace_key_id(key)
  if id then
    hl.workspace_rule({ workspace = tostring(id), monitor = place[1] })
  end
end
