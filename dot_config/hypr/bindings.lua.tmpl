-- Persönliche Keybinding-Overrides.
-- Aktuelle Belegung anzeigen:  omarchy menu keybindings --print
--
-- Hinweis: Alles, was Omarchy 4 schon selbst mitbringt (Terminal, Browser,
-- Webapps, Tiling, Media-Keys ...), steht hier bewusst NICHT mehr drin —
-- die Defaults decken das ab.

local scripts = (os.getenv("HOME") or "") .. "/.config/hypr/scripts"

-- ---------------------------------------------------------------------------
-- Defaults, die frei bleiben sollen (ohne Ersatzbelegung)
-- ---------------------------------------------------------------------------
hl.unbind("SUPER + P") -- war: Pseudo window

-- Fenster schliessen steht hier NICHT mehr (18.11.2026). Omarchy belegt es
-- selbst doppelt - SUPER+W UND SUPER+Q, beide auf hl.dsp.window.close(). Unser
-- o.bind auf SUPER+Q war also eine Dopplung (im laufenden Stand erschien
-- "Close window" zweimal), und das hl.unbind auf SUPER+W nahm eine
-- funktionierende Standardtaste weg, ohne dort etwas anderes hinzulegen.
-- Beides raus: SUPER+Q bleibt wie gewohnt, SUPER+W kommt kostenlos zurueck.

-- ---------------------------------------------------------------------------
-- Vim-Navigation: Fokus bewegen (H/J/K/L)
-- ---------------------------------------------------------------------------
hl.unbind("SUPER + J") -- war: Toggle window split
hl.unbind("SUPER + K") -- war: Keybindings
hl.unbind("SUPER + L") -- war: Toggle workspace layout

o.bind("SUPER + H", "Move focus left", hl.dsp.focus({ direction = "l" }))
o.bind("SUPER + L", "Move focus right", hl.dsp.focus({ direction = "r" }))
o.bind("SUPER + K", "Move focus up", hl.dsp.focus({ direction = "u" }))
o.bind("SUPER + J", "Move focus down", hl.dsp.focus({ direction = "d" }))

-- Aktives Fenster verschieben (SHIFT + H/J/K/L)
o.bind("SUPER + SHIFT + H", "Move window left", hl.dsp.window.move({ direction = "l" }))
o.bind("SUPER + SHIFT + L", "Move window right", hl.dsp.window.move({ direction = "r" }))
o.bind("SUPER + SHIFT + K", "Move window up", hl.dsp.window.move({ direction = "u" }))
o.bind("SUPER + SHIFT + J", "Move window down", hl.dsp.window.move({ direction = "d" }))

-- Ersatz für die überschriebenen Defaults
o.bind("SUPER + Y", "Toggle workspace layout", "omarchy-hyprland-workspace-layout-toggle")
o.bind("SUPER + SHIFT + Z", "Toggle window split", hl.dsp.layout("togglesplit"))
o.bind("SUPER + I", "Show key bindings", "omarchy-menu-keybindings")

-- ---------------------------------------------------------------------------
-- Launcher & Tastaturlayout
-- ---------------------------------------------------------------------------
-- Das Apps-Menue liegt auf Omarchys Standardtaste SUPER+ALT+SPACE - hier steht
-- dafuer bewusst NICHTS mehr. Bis 18.11.2026 lag es auf SUPER+R, weil das
-- Root-Menue SUPER+ALT+SPACE besetzt hatte; das ist jetzt umgedreht.
--
-- SUPER+R tragt stattdessen das ROOT-Menue. Dessen eigene Standardtasten sind
-- nicht nutzbar: SUPER+SPACE gehoert zwingend dem Sprachumschalter (siehe
-- unten, Hardware-Vorgabe der Corne), und die zweite,
-- SUPER+SHIFT+code:201, ist ein Sonder-Keycode, den unsere Tastaturen nicht
-- haben. SUPER+R ist im Standard frei, ueberdeckt also nichts.
o.bind("SUPER + R", "Omarchy menu", { menu = "root" })

-- NICHT auf Omarchys Standard zuruecksetzen. Geprueft und verworfen am
-- 18.11.2026, aus zwei Gruenden:
--
-- 1. WOHER DIE TASTE KOMMT: Windows legt den Sprachumschalter von sich aus auf
--    SUPER+SPACE und laesst das nicht aendern. Bastian hat Linux damals daran
--    angeglichen, damit die Geste auf beiden Systemen dieselbe ist. Eine
--    Taste, die ausserhalb unserer Konfiguration festgenagelt ist, gibt den
--    Ton an - nicht umgekehrt.
-- 2. HARDWARE: auf der Corne liegt der Umschalter auf einer Doppeltaste, die
--    genau diese Kombination sendet. Wer SUPER+SPACE hier aendert, bricht eine
--    Taste der Tastatur, nicht nur eine Belegung.
--
-- Deshalb kann das Root-Menue seine Standardtaste nicht bekommen und liegt auf
-- SUPER+R; das Apps-Menue ist dafuer zurueck auf SUPER+ALT+SPACE.
hl.unbind("SUPER + SPACE") -- war: Omarchy-Root-Menü, zieht auf SUPER + ALT + SPACE um
o.bind("SUPER + SPACE", "Switch keyboard layout", scripts .. "/toggle-kb-layout.sh")


-- ---------------------------------------------------------------------------
-- Anwendungen
-- ---------------------------------------------------------------------------
o.bind("SUPER + SHIFT + T", "Activity", { tui = "btop" })

-- yazi als Dateimanager. Beim Umstieg auf die Lua-Config verlorengegangen und
-- am 17.08.2026 nachgetragen: Omarchy 4 belegt SUPER+SHIFT+E selbst mit
-- "Email", das hier bewusst weicht (war in der alten bindings.conf ebenfalls
-- auskommentiert).
-- Absichtlich NICHT die { tui = "yazi" }-Kurzform: omarchy-launch-tui kennt
-- kein Arbeitsverzeichnis, yazi wuerde dann immer in $HOME starten statt im
-- Ordner des aktiven Terminals.
hl.unbind("SUPER + SHIFT + E") -- war: Email
o.bind(
  "SUPER + SHIFT + E",
  "File explorer (yazi)",
  "uwsm app -- ghostty --working-directory=$(omarchy-cmd-terminal-cwd) -e yazi"
)
-- superfile als Alternative daneben (19.10.2026), gleiches Muster wie yazi.
o.bind(
  "SUPER + ALT + E",
  "File explorer (superfile)",
  "uwsm app -- ghostty --working-directory=$(omarchy-cmd-terminal-cwd) -e spf"
)

-- ---------------------------------------------------------------------------
-- imkr auf Omarchys Plaetzen fuer Tmux und Herdr, wie auf dem Pi
-- ---------------------------------------------------------------------------
-- Ohne Namen geht imkr zur zuletzt besuchten Session (auf welchem Rechner auch
-- immer) und oeffnet die Session-Liste; mit Strg die Session dieses Rechners.
-- imkr liegt je nach Rechner in ~/.cargo/bin oder ~/.local/bin, beides steht
-- nicht ueberall im PATH von Hyprland. Die codingmachine heisst in chezmoi
-- "omarchy", in imkr "codingmachine".
{{- $here := .machine }}{{ if eq .machine "codingmachine" }}{{ $here = "codingmachine" }}{{ end }}
local imkr = "PATH=$HOME/.cargo/bin:$HOME/.local/bin:$PATH exec imkr"
hl.unbind("SUPER + ALT + RETURN") -- war: Tmux
hl.unbind("SUPER + CTRL + RETURN") -- war: Herdr
o.bind("SUPER + ALT + RETURN", "imkr: last session + session list", "omarchy-launch-terminal bash -c '" .. imkr .. "'")
o.bind("SUPER + CTRL + RETURN", "imkr here (session {{ $here }})", "omarchy-launch-terminal bash -c '" .. imkr .. " -s {{ $here }}'")

-- ---------------------------------------------------------------------------
-- Monitore: Ziffer = welcher Schirm
-- ---------------------------------------------------------------------------
-- Seit Omarchy 4.5 hat JEDER Monitor eigene Workspaces 1-10
-- (default/hypr/monitor-workspaces.lua). Omarchys Ziffern-Ebenen bleiben
-- deshalb hier UNANGETASTET und gelten monitor-relativ:
--
--   SUPER + 1..0               Workspace N auf diesem Monitor
--   SUPER + SHIFT + 1..0       Fenster auf Workspace N
--
-- Zwei Dinge kann Omarchy nicht, und nur die stehen hier:
--   * einen Monitor DIREKT anspringen - es gibt nur CTRL+ALT+TAB zum Zyklen
--   * ein Fenster auf einen anderen Monitor schieben, ohne drei Modifier und
--     Pfeiltasten (Omarchy: SUPER+SHIFT+CTRL+Pfeil). Auf der Corne/Swoop nicht
--     greifbar, weil dort noch der Ziffern-Layer dazukommt - Dreifach-Modifier
--     sind hier deshalb grundsaetzlich ausgeschlossen.
--
-- Beides liegt auf CTRL+ALT, und zwar mit Absicht: das ist bei Omarchy schon
-- der Monitor-Modifier (CTRL+ALT+TAB = naechster Monitor), und es ist die
-- EINZIGE Zweier-Kombination, deren Ziffern komplett frei sind. Gemessen am
-- 18.11.2026 trug CTRL+ALT nur DELETE und TAB.
--
--   CTRL + ALT + 1..0          Monitor N anspringen
--   CTRL + ALT + H/J/K/L       Fenster auf den Monitor links/runter/rauf/rechts
--
-- NICHT auf SUPER+ALT oder SUPER+CTRL: dort liegen bereits Omarchy-Defaults
-- auf den Ziffern (SUPER+ALT+1..5 = Switch to group window, SUPER+CTRL+1..9 =
-- Bar panel). Ein erster Entwurf hat die ueberdeckt - genau der Fehler, den
-- diese Datei vermeiden soll.
--
-- "Monitor N" ist bewusst der Monitor mit dem N-ten WORKSPACE-BLOCK, nicht die
-- N-te Position auf dem Schreibtisch. Omarchy verteilt die Bloecke selbst
-- (internes Panel zuerst, dann Hyprland-id) und die Leiste beschriftet sie
-- 1-10 - eine zweite, eigene Nummerierung danebenzustellen hiesse, zwei
-- Wahrheiten zu haben. Hyprlands Monitor-id direkt zu nehmen waere falsch: die
-- bekommt der Schirm, der als naechstes auftaucht.
local function monitor_of_block(n)
  local slots = (o.workspaces and o.workspaces.slots) or 10
  for _, m in ipairs(hl.get_monitors()) do
    local ws = m.active_workspace
    -- Sonder-Workspaces (scratchpad, qconsole) tragen negative ids.
    if ws and ws.id and ws.id > 0 and math.ceil(ws.id / slots) == n then
      return m
    end
  end
end

for n = 1, 10 do
  o.bind("CTRL + ALT + code:" .. tostring(n + 9), "Focus monitor " .. n, function()
    local m = monitor_of_block(n)
    if m then
      hl.dispatch(hl.dsp.focus({ monitor = m.name }))
    end
  end)
end

-- Fenster auf den Nachbarmonitor. Richtungen wie ueberall bei uns: H/J/K/L.
-- Nutzt Omarchys eigenen, block-bewussten Helfer - nur auf einer Taste, die
-- die Split-Tastatur erreicht. Omarchys Pfeil-Defaults bleiben zusaetzlich.
for dir, key in pairs({ l = "H", d = "J", u = "K", r = "L" }) do
  o.bind("CTRL + ALT + " .. key, "Move window to " .. dir .. " monitor", o.workspaces.move_window_to_monitor(dir))
end

-- ---------------------------------------------------------------------------
-- Diktat (Toggle: einmal drücken = Start, nochmal = Stop)
-- ---------------------------------------------------------------------------
-- Hier steht bewusst KEINE eigene Taste mehr (18.11.2026).
--
-- Omarchys Defaults genuegen: ALT+SPACE schaltet um, die rechte ALT ist
-- push-to-talk. Beide laufen ueber `omarchy-dictation`, und das ist selbst
-- backend-bewusst - es liest `omarchy-default-dictation` und ruft den Adapter
-- `omarchy-dictation-<backend>`. Genau dafuer war unser `dictation-record`
-- gebaut; der Grund ist entfallen, also auch die Tasten (SUPER+ALT+D und
-- SUPER+CTRL+X). Weniger Belegung, ein Weg statt zwei.
--
-- ZWEI EINSCHRAENKUNGEN, falls das zurueckgedreht werden muss:
--   1. Omarchy kennt die Adapter voxtype, superwhisper und use - NICHT
--      hyprwhspr. Wer hyprwhspr scharf schaltet, erreicht es per Hotkey nicht
--      mehr; dann braucht es wieder eine eigene Taste auf `dictation-record`
--      oder einen Adapter.
--   2. Es gibt jetzt zwei Quellen fuer "welches Backend": Omarchys
--      ~/.config/omarchy/defaults/dictation und unser `dictation-switch`
--      (liest systemd enable/disable). Die koennen auseinanderlaufen - am
--      18.11.2026 sagte Omarchy `voxtype`, der Umschalter `none`.
--
-- `dictation-switch` und `dictation-record` bleiben als Werkzeuge bestehen:
-- der Umschalter macht enable/disable des Dienstes, was Omarchy nicht tut.

-- F9 bleibt ABSICHTLICH unbelegt - die Taste gehoert den Anwendungen.
-- Achtung: Omarchys Migration vom 18.11.2026 schreibt einen F9-push-to-talk
-- (auf `omarchy-dictation`) selbst in ~/.config/hypr/bindings.lua. Dieses
-- Template kennt ihn nicht, `chezmoi apply` entfernt ihn also wieder. Taucht
-- er nach einem kuenftigen `omarchy update` erneut als Drift auf, ist das
-- erwartet und wird genauso wieder entfernt.
