-- Persönliche Keybinding-Overrides.
-- Aktuelle Belegung anzeigen:  omarchy menu keybindings --print
--
-- Hinweis: Alles, was Omarchy 4 schon selbst mitbringt (Terminal, Browser,
-- Webapps, Tiling, Media-Keys ...), steht hier bewusst NICHT mehr drin —
-- die Defaults decken das ab.

local scripts = (os.getenv("HOME") or "") .. "/.config/hypr/scripts"

-- ---------------------------------------------------------------------------
-- Defaults, die frei bleiben sollen (ohne Ersatzbelegung)
-- ---------------------------------------------------------------------------
-- Nur alte Doppelbelegungen freiräumen. Neue Omarchy-4-Funktionen
-- (SUPER+SHIFT+W = Omawrite, SUPER+SHIFT+SPACE = Top-Bar) bleiben aktiv.
hl.unbind("SUPER + W") -- war: Close window (nutze SUPER + Q)
hl.unbind("SUPER + P") -- war: Pseudo window

-- ---------------------------------------------------------------------------
-- Fenster schließen
-- ---------------------------------------------------------------------------
o.bind("SUPER + Q", "Close window", hl.dsp.window.close())

-- ---------------------------------------------------------------------------
-- Vim-Navigation: Fokus bewegen (H/J/K/L)
-- ---------------------------------------------------------------------------
hl.unbind("SUPER + J") -- war: Toggle window split
hl.unbind("SUPER + K") -- war: Keybindings
hl.unbind("SUPER + L") -- war: Toggle workspace layout

o.bind("SUPER + H", "Move focus left", hl.dsp.focus({ direction = "l" }))
o.bind("SUPER + L", "Move focus right", hl.dsp.focus({ direction = "r" }))
o.bind("SUPER + K", "Move focus up", hl.dsp.focus({ direction = "u" }))
o.bind("SUPER + J", "Move focus down", hl.dsp.focus({ direction = "d" }))

-- Aktives Fenster verschieben (SHIFT + H/J/K/L)
o.bind("SUPER + SHIFT + H", "Move window left", hl.dsp.window.move({ direction = "l" }))
o.bind("SUPER + SHIFT + L", "Move window right", hl.dsp.window.move({ direction = "r" }))
o.bind("SUPER + SHIFT + K", "Move window up", hl.dsp.window.move({ direction = "u" }))
o.bind("SUPER + SHIFT + J", "Move window down", hl.dsp.window.move({ direction = "d" }))

-- Ersatz für die überschriebenen Defaults
o.bind("SUPER + Y", "Toggle workspace layout", "omarchy-hyprland-workspace-layout-toggle")
o.bind("SUPER + SHIFT + Z", "Toggle window split", hl.dsp.layout("togglesplit"))
o.bind("SUPER + I", "Show key bindings", "omarchy-menu-keybindings")

-- ---------------------------------------------------------------------------
-- Launcher & Tastaturlayout
-- ---------------------------------------------------------------------------
-- Früher walker; Omarchy 4 hat walker/elephant entfernt und durch das eigene
-- Quickshell-Menü ersetzt.
o.bind("SUPER + R", "Launch apps", "omarchy-menu toggle apps")

hl.unbind("SUPER + SPACE") -- war: Omarchy-Root-Menü, zieht auf SUPER + ALT + SPACE um
o.bind("SUPER + SPACE", "Switch keyboard layout", scripts .. "/toggle-kb-layout.sh")

-- Root-Menü braucht ein neues Zuhause: SUPER + ALT + SPACE zeigte bisher das
-- Apps-Menü, das jetzt auf SUPER + R liegt — also doppelt belegt.
hl.unbind("SUPER + ALT + SPACE") -- war: Apps menu (jetzt auf SUPER + R)
o.bind("SUPER + ALT + SPACE", "Omarchy menu", "omarchy-menu toggle root")

-- ---------------------------------------------------------------------------
-- Anwendungen
-- ---------------------------------------------------------------------------
o.bind("SUPER + SHIFT + T", "Activity", { tui = "btop" })

-- ---------------------------------------------------------------------------
-- qtile-Mode: Workspace-Wechsel optional immer auf den Haupt-Monitor holen
-- ---------------------------------------------------------------------------
o.bind("SUPER + ALT + Q", "Toggle qtile-Mode", scripts .. "/toggle-qtile-mode.sh")

for ws = 1, 10 do
  local key = "SUPER + code:" .. tostring(ws + 9)
  hl.unbind(key) -- war: Switch to workspace N
  o.bind(key, "Switch to workspace " .. ws, scripts .. "/ws-switch.sh " .. ws)
end

-- ---------------------------------------------------------------------------
-- Diktat (Toggle: einmal drücken = Start, nochmal = Stop)
-- ---------------------------------------------------------------------------
-- Seit Omarchy 4 über voxtype. Auf Rechnern, die noch hyprwhspr fahren, greift
-- automatisch der zweite Zweig. Omarchy legt bei vorhandenem voxtype zusätzlich
-- SUPER+CTRL+X und F9 (push-to-talk) auf dieselbe Funktion.
-- Seit Omarchy 4 stehen voxtype und hyprwhspr nebeneinander. Sie duerfen nicht
-- gleichzeitig laufen (gleiche Audio-Quelle, je ein large-v3 im VRAM), deshalb
-- waehlt `dictation-switch` genau eines aus - per Omarchy-Menue > Diktat.
-- Die Taste zeigt bewusst NICHT direkt auf ein Backend, sondern auf
-- `dictation-record`: das entscheidet erst beim Druck, welcher Dienst laeuft.
-- Dadurch braucht ein Backend-Wechsel keinen Hyprland-Reload.
o.bind("SUPER + ALT + D", "Speech-to-text", "dictation-record toggle")

-- Omarchy legt bei vorhandenem voxtype zusaetzlich SUPER+CTRL+X (Toggle) und
-- F9 (push-to-talk) direkt auf voxtype. Der Toggle wird hier auf denselben
-- Wrapper umgebogen, sonst greift er ins Leere, sobald hyprwhspr aktiv ist.
-- F9 bleibt unangetastet: dessen Release-Binding laesst sich mit der
-- Lua-API nicht zuverlaessig nachbauen - push-to-talk gilt also nur fuer
-- voxtype.
hl.unbind("SUPER + CTRL + X")
o.bind("SUPER + CTRL + X", "Toggle dictation", "dictation-record toggle")

-- ---------------------------------------------------------------------------
-- TigerVNC
-- ---------------------------------------------------------------------------
o.bind("SUPER + CTRL + ALT + O", "TigerVNC Menu", "xdotool key F8")

-- Passthrough-Modus: alle Tasten an VNC durchreichen
hl.define_submap("vnc_passthrough", function()
  o.bind("SUPER + CTRL + ALT + P", "VNC Passthrough aus", hl.dsp.submap("reset"))
end)
o.bind("SUPER + CTRL + ALT + P", "VNC Passthrough ein", hl.dsp.submap("vnc_passthrough"))
