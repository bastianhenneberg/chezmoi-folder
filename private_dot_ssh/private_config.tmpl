{{ if eq .machine "omarchy" -}}
# Globale Settings (MUSS oben stehen)
Host *
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes
    ConnectTimeout 10
    IPQoS none
    ControlMaster auto
    # `yes` statt einer Frist: Die Verbindung bleibt offen, bis sie
    # ausdruecklich geschlossen wird (`ssh -O exit <alias>`). Mit 10m
    # fiel der Master mitten in laengeren Sitzungen weg, und der
    # naechste Aufruf baute neu auf — genau die Verbindungen, die auf
    # den infra-monitor-Hosts fail2ban ausloesen.
    ControlPersist yes
    ControlPath ~/.ssh/cm/%r@%h:%p

