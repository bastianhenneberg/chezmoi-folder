# Wird von chezmoi immer als Template gelesen. Pfade sind ZIEL-Pfade
# (ohne dot_-Praefix), relativ zu $HOME.

{{ if ne .machine "laptop" -}}
# Chromium-Wrapper fuer die AMD-iGPU des Laptops: erzwingt
# LIBVA_DRIVER_NAME=radeonsi. Auf Desktop (nur RTX 3080) und omarchy gibt es
# keinen radeonsi-Treiber - Chromium wuerde dort die Hardware-Videodekodierung
# verlieren. Deshalb nur auf dem Laptop ausrollen.
.local/bin/chromium-wrapper
.local/share/applications/chromium.desktop
{{ end -}}

{{ if ne .machine "pi" -}}
# Nur auf dem Pi (pimarchy-on-the-road): seine Tastenkuerzel auf Pimarchy und
# die bash-Ergaenzungen. Die Omarchy-Rechner haben eigene Dateien dafuer.
.config/hypr/bastian.lua
.config/hypr/scripts/pi-menu.sh
.bash_aliases
.local/bin/claude
.local/bin/codex
{{ end -}}

{{ if eq .machine "pi" -}}
# Pi (pimarchy-on-the-road): eigene Richtlinie. Er laeuft mit Raspberry Pi OS
# + Pimarchy, nicht mit Omarchy. Pimarchy besitzt hyprland.lua/bindings.lua und
# die bash-Grundlage; chezmoi legt nur Bastians Gewohnheiten obendrauf
# (git, .config/hypr/bastian.lua, toggle-kb-layout.sh, .bash_aliases,
# ~/.local/bin/claude und codex als Links auf die mise-Installation: eine
# Login-Shell ohne Terminal (`bash -lc`, so ruft imkr per ssh auf) liest unter
# Raspberry Pi OS keine .bashrc und fand sie sonst nicht).
#
# Bewusst KEINE SSH-Schluessel und kein age-Schluessel: ein Geraet fuer
# unterwegs braucht die Forge-/Server-Schluessel nicht (Entscheidung Bastian,
# 10.11.2026). Der Pi hat seinen eigenen imkr-Schluessel und eine handgepflegte
# ~/.ssh/config, beides bleibt unangetastet.
.ssh
.ssh/**
.bashrc
.zshrc
