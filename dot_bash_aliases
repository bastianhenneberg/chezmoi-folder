# Pi (pimarchy-on-the-road) only, see .chezmoiignore. Raspberry Pi OS's
# ~/.bashrc sources this file; Pimarchy keeps ~/.bashrc and ~/.bashrc.pimarchy.

# Claude Code, Codex and node come from mise, as on the laptop. Shims also
# reach imkr's ssh logins and agent starts that don't run `mise activate`.
if [ -x "$HOME/.local/bin/mise" ]; then
    export PATH="$HOME/.local/share/mise/shims:$PATH"
    eval "$("$HOME/.local/bin/mise" activate bash)"
fi

# imkr: Tab completion for its commands, sessions and hosts
command -v imkr >/dev/null 2>&1 && eval "$(imkr completions bash 2>/dev/null)"
